<?xml version="1.0" encoding="utf-8"?>
<!--
  Roda com: dotnet test usando o parametro settings apontando para este arquivo,
  junto com o coletor "XPlat Code Coverage" (a partir da pasta backend/, com o
  SyncBar.sln). Gera um Cobertura XML por projeto de teste em
  test/PROJETO/TestResults/GUID/coverage.cobertura.xml. Para ver o % agregado em HTML, instale o
  ReportGenerator uma vez (dotnet tool install -g dotnet-reportgenerator-globaltool) e rode:
    reportgenerator -reports:"test/**/coverage.cobertura.xml" -targetdir:coveragereport -reporttypes:Html
  Depois abra coveragereport/index.html.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Infra pura (EF Core configs/migrations, clients HTTP) fica fora da meta de 80%
               nesta fase — o alvo é regra de negócio (Domain + Application). Ajuste conforme os
               módulos forem sendo cobertos. -->
          <!-- Achado de revisão: com ExcludeByAttribute ativo, o coletor "XPlat Code Coverage"
               falhava silenciosamente ao instrumentar WindowsRawPrinterTransport.cs — o único tipo
               do projeto com código gerado por LibraryImportAttribute (P/Invoke) — e isso derrubava
               a instrumentação do assembly SyncBar.Infrastructure INTEIRO (sumia do relatório, 0%
               em todo arquivo do projeto, não só nesta classe). Excluir esta classe por nome
               ANTES do filtro por atributo evita o problema; sem esta linha, nenhuma cobertura de
               SyncBar.Infrastructure aparece no cobertura.xml, mesmo com os testes existindo. -->
          <Exclude>[SyncBar.Infrastructure]SyncBar.Infrastructure.Persistence.Migrations.*,[SyncBar.Infrastructure]SyncBar.Infrastructure.Printing.WindowsRawPrinterTransport</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
